<?xml version="1.0" encoding="utf-8"?>
<!-- Default language (English). Translations go in values-xx/strings.xml. -->
<resources>
    <string name="app_name" translatable="false">LlamaditApp</string>
    <!-- Name of the notification access entry in Android settings -->
    <string name="whatsapp_listener_label">LlamaditApp: WhatsApp calls</string>
    <!-- Toast when WhatsApp cannot be opened -->
    <string name="whatsapp_open_failed">Could not open WhatsApp</string>
    <!-- Toast when another app cannot be opened -->
    <string name="open_failed">Could not open it</string>
    <!-- Label of the WhatsApp video call row written in the contact -->
    <string name="whatsapp_video_row">Video call</string>
    <!-- Appended to SMS. %1$d = percent -->
    <string name="battery_level">Battery %1$d%%</string>
    <!-- Appended to SMS. %1$d = percent -->
    <string name="battery_level_charging">Battery %1$d%% (charging)</string>
    <!-- SMS. %1$s = Google Maps link, %2$d = accuracy in metres, %3$s = time -->
    <string name="location_detail">%1$s (±%2$d m, %3$s)</string>
    <!-- SMS reply to a location request. %1$s = location_detail -->
    <string name="locate_reply">Location: %1$s</string>
    <!-- SMS reply when the location could not be obtained -->
    <string name="locate_reply_failed">Could not get the location right now.</string>
    <!-- First SOS SMS. %1$s = location_detail or sos_no_location -->
    <string name="sos_first">SOS: I need help. I am here: %1$s</string>
    <!-- SOS update SMS. %1$d = number, %2$d = total, %3$s = location -->
    <string name="sos_update">SOS: updated location (%1$d/%2$d): %3$s</string>
    <!-- Last SOS SMS. %1$d = number, %2$d = total, %3$s = location -->
    <string name="sos_last">SOS: last location (%1$d/%2$d): %3$s</string>
    <!-- Inside the SOS SMS when there is no location -->
    <string name="sos_no_location">could not get the location.</string>
    <!-- Notification channel name -->
    <string name="notification_channel_location">Location</string>
    <!-- Ongoing notification while answering a location request -->
    <string name="notification_locate">Sending the location by SMS</string>
    <!-- Ongoing notification while SOS is active -->
    <string name="notification_sos">SOS active: sending the location for 30 minutes</string>
    <!-- Message/call time. %1$s = time -->
    <string name="yesterday_at">Yesterday %1$s</string>
