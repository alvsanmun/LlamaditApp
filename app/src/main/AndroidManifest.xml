<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Botón para hacer fotos; solo se usa con esa pantalla abierta. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Escribir la fila de videollamada de WhatsApp en los favoritos marcados. -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- WhatsApp completo: la casa para volver, dibujada encima de WhatsApp. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Contactos desde una cuenta de Google: ver las cuentas y su sincronización. -->
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- En Android reciente, enviar SMS consulta datos de la SIM y exige este permiso. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Botones de mensajes (leer SMS) y de llamadas perdidas (registro de llamadas). -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Ubicación con la app en segundo plano (petición por SMS con la pantalla apagada).
         Como Device Owner (paso 6) se concederá sin preguntar. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Radio: es lo único que usa internet (las emisoras y su directorio, radio-browser.info).
         Sigue sonando con la pantalla apagada (servicio en primer plano de tipo multimedia). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Gestión a distancia: pedir que Android no corte la conexión en reposo. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Quiosco en pausa tras reiniciar: LlamaditApp no se abre sola y este aviso la trae. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Avisos de las pastillas a su hora exacta, también en reposo. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- Las llamadas entrantes siempre vibran. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Sensor de proximidad durante las llamadas (apaga la pantalla junto a la oreja). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- El quiosco apaga el Wi-Fi: el móvil solo usa 4G. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Apagar el giro automático: el móvil siempre en vertical, también en WhatsApp.
         Acceso especial: adb shell appops set com.launcherfacil.app WRITE_SETTINGS allow -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+: para poder comprobar si WhatsApp está instalado. -->
    <queries>
        <package android:name="com.whatsapp" />
        <!-- Con el quiosco en pausa, el inicio pasa a ser el del móvil: hay que encontrarlo. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.LlamaditApp"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- App de Teléfono: abrir el teclado con un número ("marcar"). Android exige
                 estos filtros para poder ser la app de Teléfono predeterminada. -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
            <!-- Pantalla de inicio (launcher). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Pantalla de llamada propia (somos la app de Teléfono predeterminada). -->
        <activity
            android:name=".call.CallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />

        <service
            android:name=".call.CallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <!-- El tono lo pone la app (CallRinger): así no se silencia con los botones de volumen. -->
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_RINGING"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- Llamadas entrantes de WhatsApp con nuestra pantalla (lee sus notificaciones). -->
        <activity
            android:name=".whatsapp.WhatsAppCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />

        <service
            android:name=".whatsapp.WhatsAppCallListener"
            android:exported="true"
            android:label="@string/whatsapp_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Device Owner (modo quiosco). -->
        <receiver
            android:name=".kiosk.AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".kiosk.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Avisos a pantalla completa: batería baja y pastillas. -->
        <activity
            android:name=".alerts.ReminderActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />

        <receiver
            android:name=".pills.PillAlarmReceiver"
            android:exported="false" />

        <service
            android:name=".sos.SosService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <service
            android:name=".locate.LocateService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Firebase no se inicia solo: cada familia conecta su propio proyecto (remote/Remote.kt). -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />

        <!-- Para que la cámara guarde la foto del portal (configuración del cuidador). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".gohome.GoHomeService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Radio en segundo plano. -->
        <service
            android:name=".radio.RadioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Petición de ubicación por SMS. Solo el sistema puede enviar este broadcast. -->
        <receiver
            android:name=".locate.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
