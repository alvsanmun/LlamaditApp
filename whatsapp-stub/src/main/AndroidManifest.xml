<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Para simular llamadas entrantes con notificación (como WhatsApp). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application android:label="WhatsApp (falso)">
        <activity
            android:name=".StubActivity"
            android:exported="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/vnd.com.whatsapp.voip.call" />
                <data android:mimeType="vnd.android.cursor.item/vnd.com.whatsapp.video.call" />
            </intent-filter>
        </activity>

        <!-- Simula una llamada entrante (el comando adb está en SimulateCall.kt). -->
        <receiver
            android:name=".SimulateCallReceiver"
            android:exported="true" />

        <receiver
            android:name=".DeclineReceiver"
            android:exported="false" />
    </application>

</manifest>
